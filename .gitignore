# 一時ファイル（ダウンロードしたzip、サーバログ等）
tmp/

# セッションログ・補助スクリプト（会話ログを含むため公開しない）
etc/

# 自動生成するログ・レポート
logs/

# 非公開フォルダ
_*

# ローカル設定
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/

# llama.cpp の配布バイナリ
# NVIDIA の CUDA 再頒布DLL を含み、100MB を超えるファイルもあるため管理対象外。
# 取得手順は実行計画の導入手順を参照。
bin/
